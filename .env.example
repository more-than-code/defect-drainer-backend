# Copy to .env (gitignored) for local runs:
#
#   cp .env.example .env && pnpm dev
#
# Loaded by loadEnvFile() inside main() when the server starts — not at module
# import, so tests that import buildApp do NOT inherit this file. Values already
# present in the process environment are NOT overridden, so container envs and
# one-off `FOO=bar pnpm dev` invocations still win.

# --- Phase B search -------------------------------------------------------
# Set this and every backend start indexes to OpenSearch. Leave it unset and
# search falls back to Phase A FTS — but note that writes then reach SQLite
# only: publishDocuments() returns early without enqueueing to search_outbox,
# so the index drifts with no error surfaced. Recover with:
#   curl -X POST http://127.0.0.1:8788/api/search/reindex
#
# Start a local cluster first: pnpm search:up
DEFECT_DRAINER_OPENSEARCH_URL=http://127.0.0.1:9200
DEFECT_DRAINER_OPENSEARCH_INDEX=defect-drainer-artifacts

# --- Other knobs (defaults are fine locally) ------------------------------
# Canonical prefix is DEFECT_DRAINER_* (see src/env.ts).
# DEFECT_DRAINER_HOST=127.0.0.1
# DEFECT_DRAINER_PORT=8788
# DEFECTS_ROOT=..                    # inventory root (evidence/, open/, resolved/)
# DEFECT_DRAINER_DATA=./.data        # SQLite, batch-jobs/, clones/
# DEFECT_DRAINER_NORMALIZE_MODE=local
