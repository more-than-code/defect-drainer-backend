{
  "name": "defect-drainer-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs src/server.ts",
    "dev:free": "lsof -ti:8788 | xargs kill -9 2>/dev/null; node ./node_modules/tsx/dist/cli.mjs src/server.ts",
    "start": "node dist/server.js",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
